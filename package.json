{
  "name": "dsh-plugin-salary-dance",
  "version": "1.4.7",
  "description": "薪跳 SalaryDance —— 常驻 DSH Web 界面右上角的实时薪资跳动悬浮卡片，带两步设置面板与按法定节假日计算的当月工作日历时薪。",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "salary-dance",
    "salary",
    "widget"
  ],
  "scripts": {
    "test": "node test/math.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhouxf08/dsh-plugin-salary-dance.git"
  },
  "homepage": "https://github.com/zhouxf08/dsh-plugin-salary-dance#readme",
  "bugs": {
    "url": "https://github.com/zhouxf08/dsh-plugin-salary-dance/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
